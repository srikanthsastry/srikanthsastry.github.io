---
import Layout from '@/layouts/Layout.astro'
---

<Layout>
  <h1 class="font-title text-10 font-semibold tracking-tight lg:text-11 mb-6">Search</h1>

  <!-- Search Form -->
  <form id="search-form" class="mb-8" role="search">
    <div class="flex gap-3">
      <input
        id="search-input"
        type="text"
        placeholder="Search posts and garden notes…"
        autocomplete="off"
        class="flex-1 rounded-lg border border-secondary/20 bg-transparent px-4 py-2.5 text-4 leading-relaxed c-primary placeholder:c-secondary/40 outline-none focus:border-secondary/50 transition-colors"
      />
      <button
        type="submit"
        class="rounded-lg border border-secondary/20 px-4 py-2.5 c-secondary hover:c-primary hover:border-secondary/50 bg-transparent cursor-pointer transition-colors"
        aria-label="Search"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>
    </div>
  </form>

  <!-- Results -->
  <div id="search-results"></div>
</Layout>

<style is:global>
  /* Pagefind result styling */
  .pagefind-ui .pagefind-ui__search-clear,
  .pagefind-ui .pagefind-ui__search-input,
  .pagefind-ui .pagefind-ui__form::before {
    display: none !important;
  }
  .pagefind-ui .pagefind-ui__form {
    padding: 0 !important;
  }
  .pagefind-ui .pagefind-ui__drawer {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }
  .pagefind-ui .pagefind-ui__result-link {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif !important;
    font-weight: 600 !important;
    font-size: 1.05rem !important;
  }
  html.dark .pagefind-ui .pagefind-ui__result-link {
    color: oklch(90% 0.02 85) !important;
  }
  html:not(.dark) .pagefind-ui .pagefind-ui__result-link {
    color: oklch(25% 0.02 60) !important;
  }
  .pagefind-ui .pagefind-ui__result-excerpt {
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif !important;
    font-size: 0.875rem !important;
    line-height: 1.6 !important;
  }
  html.dark .pagefind-ui .pagefind-ui__result-excerpt {
    color: oklch(70% 0.015 85) !important;
  }
  html:not(.dark) .pagefind-ui .pagefind-ui__result-excerpt {
    color: oklch(45% 0.015 60) !important;
  }
  html.dark .pagefind-ui .pagefind-ui__result {
    border-top-color: oklch(100% 0 0 / 0.08) !important;
  }
  html:not(.dark) .pagefind-ui .pagefind-ui__result {
    border-top-color: oklch(0% 0 0 / 0.08) !important;
  }
  html.dark .pagefind-ui .pagefind-ui__message {
    color: oklch(70% 0.015 85) !important;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif !important;
  }
  html:not(.dark) .pagefind-ui .pagefind-ui__message {
    color: oklch(45% 0.015 60) !important;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif !important;
  }
  html.dark .pagefind-ui .pagefind-ui__button {
    background: oklch(30% 0.01 270) !important;
    color: oklch(90% 0.02 85) !important;
  }
  html:not(.dark) .pagefind-ui .pagefind-ui__button {
    background: oklch(92% 0.005 85) !important;
    color: oklch(25% 0.02 60) !important;
  }
  .pagefind-ui .pagefind-ui__result-thumb {
    display: none !important;
  }
</style>

<script>
  let pagefindInstance: any = null;

  function getQuery(): string {
    return new URLSearchParams(window.location.search).get('q') || '';
  }

  function setQuery(q: string) {
    const url = new URL(window.location.href);
    if (q) {
      url.searchParams.set('q', q);
    } else {
      url.searchParams.delete('q');
    }
    history.replaceState(null, '', url.toString());
  }

  async function initPagefind() {
    if (pagefindInstance) return;

    // Load Pagefind CSS
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);

    // Load Pagefind JS
    return new Promise<void>((resolve) => {
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => {
        // @ts-ignore
        pagefindInstance = new window.PagefindUI({
          element: '#search-results',
          showSubResults: true,
          showImages: false,
          autofocus: false,
          resetStyles: false,
        });
        resolve();
      };
      document.head.appendChild(script);
    });
  }

  async function doSearch(query: string) {
    if (!query.trim()) return;

    await initPagefind();

    // Pagefind UI has its own hidden input; we need to set it and trigger search
    const pfInput = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
    if (pfInput) {
      pfInput.value = query;
      pfInput.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  function setup() {
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    if (!form || !input) return;

    // Read initial query from URL
    const initialQuery = getQuery();
    if (initialQuery) {
      input.value = initialQuery;
      doSearch(initialQuery);
    } else {
      input.focus();
    }

    // Handle form submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (q) {
        setQuery(q);
        doSearch(q);
      }
    });
  }

  // Run on initial load and after Astro view transitions
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
