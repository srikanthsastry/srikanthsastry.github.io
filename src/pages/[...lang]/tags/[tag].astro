---
import PostCard from '@/components/PostCard.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag, getTagSupportedLangs } from '@/utils/content'

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const langTags = await getAllTags(lang)
    return langTags.map(tag => ({
      params: { lang: getLangRouteParam(lang), tag },
      props: { tag },
    }))
  }))
  return paths.flat()
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const posts = await getPostsByTag(tag, currentLang)
const supportedLangs = await getTagSupportedLangs(tag)
---

<Layout supportedLangs={supportedLangs}>
  <h1 class="font-title text-10 font-semibold tracking-tight lg:text-11 mb-2">
    {tag}
  </h1>
  <p class="mb-8 c-secondary text-3.75 leading-relaxed">
    {posts.length} {posts.length === 1 ? 'post' : 'posts'} · <a href="/tags/" class="underline decoration-secondary/50 underline-offset-3 hover:c-primary transition-colors">All tags</a>
  </p>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    {posts.map((post) => (
      <PostCard post={post} lang={currentLang} />
    ))}
  </div>
</Layout>
