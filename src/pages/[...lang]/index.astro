---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import PostCard from '@/components/PostCard.astro'
import PostDate from '@/components/PostDate.astro'
import PostList from '@/components/PostList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getPostPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { getPinnedPosts, getPosts } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const pinnedPosts = await getPinnedPosts(currentLang)
const allPosts = await getPosts(currentLang)
const recentPosts = allPosts.filter(p => !p.data.pin).slice(0, 8)
const heroPost = recentPosts[0]
const gridPosts = recentPosts.slice(1)

// Get garden notes, sorted by title, grouped by maturity
const gardenNotes: CollectionEntry<'garden'>[] = await getCollection('garden')
const evergreenNotes = gardenNotes
  .filter(n => n.data.maturity === 'evergreen')
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 6)
const buddingNotes = gardenNotes
  .filter(n => n.data.maturity === 'budding')
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 4)
const featuredNotes = [...evergreenNotes, ...buddingNotes]

const totalPosts = allPosts.length
const totalNotes = gardenNotes.length
---

<Layout>
  <!-- Intro Section -->
  <section class="mb-12">
    <div class="clearfix">
      <img
        src="/assets/images/2021/07/img_2471-copy-450x450.jpg"
        alt="Srikanth Sastry"
        class="float-left w-24 h-24 rounded-full object-cover ring-2 ring-secondary/10 mr-5 mb-3 lg:(w-32 h-32 mr-6 mb-4)"
      />
      <div class="text-4 leading-relaxed c-secondary/90">
        <p class="mb-4">
          I am Srikanth Sastry. I am currently an engineering lead at <a href="https://meta.com" class="font-semibold underline decoration-secondary/50 underline-offset-3 hover:c-primary transition-colors">Meta</a> working on privacy infrastructure. Before Meta, I was a software engineer at Google in Cambridge, MA, and before that a postdoctoral associate with Nancy Lynch at <a href="https://csail.mit.edu" class="font-semibold underline decoration-secondary/50 underline-offset-3 hover:c-primary transition-colors">CSAIL, MIT</a>. Prior to that, I received my PhD from <a href="https://www.tamu.edu" class="font-semibold underline decoration-secondary/50 underline-offset-3 hover:c-primary transition-colors">Texas A&amp;M University</a>.
        </p>
        <p class="mb-4">
          My professional interests include distributed system design, software engineering processes, and building engineering teams. I also maintain a <a href="/garden/" class="font-semibold underline decoration-secondary/50 underline-offset-3 hover:c-primary transition-colors">digital garden</a> — a collection of evolving ideas and notes that complement my blog posts.
        </p>
        <p class="mb-4 c-secondary/75">
          In a previous life, during my years in academia, I worked on distributed systems, networking, fault tolerance, and algorithm design and analysis. My list of <a href="/publications" class="font-semibold underline decoration-secondary/50 underline-offset-3 hover:c-primary transition-colors">publications</a> are available on <a href="https://dblp.org/pid/39/1050.html" class="font-semibold underline decoration-secondary/50 underline-offset-3 hover:c-primary transition-colors" target="_blank" rel="noopener noreferrer">DBLP</a>.
        </p>
      </div>
    </div>

    <!-- Social Icons -->
    <div class="flex items-center gap-4 mt-4">
      <a href="https://github.com/srikanthsastry" target="_blank" rel="noopener noreferrer" class="c-secondary/60 hover:c-primary transition-colors" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://www.threads.com/@sri.sastry" target="_blank" rel="noopener noreferrer" class="c-secondary/60 hover:c-primary transition-colors" aria-label="Threads">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.17.408-2.265 1.33-3.084.88-.782 2.07-1.237 3.45-1.32 1.077-.066 2.075.043 2.975.322-.12-.636-.376-1.137-.77-1.49-.534-.477-1.327-.722-2.356-.727h-.053c-.78 0-1.855.245-2.532.99l-1.46-1.345C9.064 6.344 10.52 5.8 12.057 5.8h.073c1.543.013 2.756.47 3.606 1.36.758.794 1.237 1.884 1.427 3.239.474.156.917.354 1.32.598 1.152.7 2.01 1.667 2.483 2.798.737 1.764.8 4.665-1.467 6.885C17.64 22.505 15.33 23.28 12.186 24zm-.09-9.792c-1.295.078-2.342.655-2.342 1.768.017.36.152.667.414.913.36.339.91.528 1.548.494 1.086-.057 1.87-.537 2.396-1.466.264-.464.456-1.031.57-1.69-.63-.175-1.316-.075-2.586-.02z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/srikanthsastry/" target="_blank" rel="noopener noreferrer" class="c-secondary/60 hover:c-primary transition-colors" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:srikanth@sastry.name" class="c-secondary/60 hover:c-primary transition-colors" aria-label="Email">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
      </a>
    </div>
  </section>

  <!-- Pinned Posts -->
  {pinnedPosts.length > 0 && (
    <section class="mb-10">
      <div class="uno-decorative-line" />
      <PostList posts={pinnedPosts} lang={currentLang} pinned={true} />
    </section>
  )}

  <!-- Recent Writing -->
  <section class="mb-10">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="font-title text-5 font-semibold tracking-tight">Recent Writing</h2>
      <a href="/posts/" class="font-title text-3.5 c-secondary hover:c-primary transition-colors">
        All {totalPosts} posts →
      </a>
    </div>
    <div class="uno-decorative-line" />

    <!-- Hero: Latest Post -->
    {heroPost && (() => {
      const heroSlug = heroPost.data.abbrlink || heroPost.id
      return (
        <a
          href={getPostPath(heroSlug, currentLang)}
          class="group block overflow-hidden rounded-lg border border-secondary/10 hover:border-secondary/30 transition-all duration-200 mb-6"
        >
          {heroPost.data.image && (
            <div class="aspect-[2/1] overflow-hidden bg-secondary/5">
              <img
                src={heroPost.data.image}
                alt={heroPost.data.title}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="eager"
              />
            </div>
          )}
          <div class="p-5">
            <h3 class="font-title font-semibold text-5 leading-snug group-hover:c-primary transition-colors mb-2">
              {heroPost.data.title}
            </h3>
            {heroPost.data.description && (
              <p class="c-secondary/70 text-3.5 leading-relaxed mb-3 line-clamp-2">{heroPost.data.description}</p>
            )}
            <div class="text-3.25 font-time c-secondary/50">
              <PostDate
                date={heroPost.data.published}
                minutes={heroPost.remarkPluginFrontmatter.minutes}
              />
            </div>
          </div>
        </a>
      )
    })()}

    <!-- Remaining posts grid -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {gridPosts.map((post) => (
        <PostCard post={post} lang={currentLang} />
      ))}
    </div>
  </section>

  <!-- Garden Preview -->
  <section class="mb-10">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="font-title text-5 font-semibold tracking-tight">From the Garden</h2>
      <a href="/garden/" class="font-title text-3.5 c-secondary hover:c-primary transition-colors">
        All {totalNotes} notes →
      </a>
    </div>
    <div class="uno-decorative-line" />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {featuredNotes.map(note => (
        <a
          href={`/garden/${note.id}/`}
          class="group block rounded-lg border border-secondary/10 p-4 hover:border-secondary/25 transition-colors"
        >
          <div class="flex items-start justify-between gap-2 mb-1.5">
            <h3 class="font-title font-medium text-4 leading-snug group-hover:c-primary transition-colors">
              {note.data.title}
            </h3>
            <span class="text-3 flex-shrink-0">
              {note.data.maturity === 'evergreen' ? '🌳' : '🌿'}
            </span>
          </div>
          {note.data.excerpt_text && (
            <p class="c-secondary text-3.25 leading-relaxed mb-2 line-clamp-2">{note.data.excerpt_text}</p>
          )}
          {note.data.tags && note.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {note.data.tags.slice(0, 3).map((tag: string) => (
                <span class="text-2.75 px-1.5 py-0.5 rounded-full bg-secondary/8 c-secondary/70">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
</Layout>
