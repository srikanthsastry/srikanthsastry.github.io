---
import { themeConfig } from '@/config'

const { author } = themeConfig.site
const { startYear } = themeConfig.footer
const currentYear = new Date().getFullYear()
const year = Number(startYear) === currentYear ? startYear : `${startYear}-${currentYear}`
---

<footer class="mt-16 border-t border-secondary/15 pt-10 pb-8">
  <div class="text-center">
    <p class="font-title text-4 font-medium mb-5 c-primary">Let's keep in touch</p>

    <!-- Social Icons -->
    <div class="flex justify-center items-center gap-5 mb-6">
      <a href="https://github.com/srikanthsastry" target="_blank" rel="noopener noreferrer" class="c-secondary hover:c-primary transition-colors" aria-label="GitHub">
