    </div>

    <!-- Page Directory -->
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1.5 mb-6 text-3.5 font-navbar">
      <a href="/" class="c-secondary hover:c-primary transition-colors">Home</a>
      <a href="/posts/" class="c-secondary hover:c-primary transition-colors">Posts</a>
      <a href="/garden/" class="c-secondary hover:c-primary transition-colors">Garden</a>
      <a href="/tags/" class="c-secondary hover:c-primary transition-colors">Tags</a>
      <a href="/publications/" class="c-secondary hover:c-primary transition-colors">Publications</a>
      <a href="/touchstone-radio-episodes/" class="c-secondary hover:c-primary transition-colors">Touchstone Radio</a>
    </nav>

    <!-- Copyright -->
    <p class="text-3 c-secondary/50">
      © {year} {author} · Powered by
      <a class="hover:c-primary transition-colors" href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
      and
      <a class="hover:c-primary transition-colors" href="https://github.com/radishzzz/astro-theme-retypeset" target="_blank" rel="noopener noreferrer">Retypeset</a>
    </p>
  </div>
</footer>
