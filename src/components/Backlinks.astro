---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

interface Props {
  currentId: string
  collection: 'garden' | 'posts'
  relatedNotes?: string[]
  relatedPosts?: string[]
}

const { currentId, collection, relatedNotes = [], relatedPosts = [] } = Astro.props

// Gather all garden notes and posts
const allNotes: CollectionEntry<'garden'>[] = await getCollection('garden')
const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts')

// Build lookups
const maturityBySlug = new Map(allNotes.map(n => [n.id, n.data.maturity]))
const noteBySlug = new Map(allNotes.map(n => [n.id, n]))
const postByAbbrlink = new Map(allPosts.map(p => [p.data.abbrlink || p.id, p]))

function gardenEmoji(slug: string): string {
  const m = maturityBySlug.get(slug)
  if (m === 'evergreen') return '🌳'
  if (m === 'budding') return '🌿'
  return '🌱'
}

interface Connection {
  title: string
  href: string
  type: 'garden' | 'post'
  slug?: string
}

const seen = new Set<string>() // track hrefs to deduplicate
const connections: Connection[] = []

function add(conn: Connection) {
  if (seen.has(conn.href)) return
  seen.add(conn.href)
  connections.push(conn)
}

// ── 1. Forward-declared connections from this note's frontmatter ──

// related_notes: explicit garden↔garden
for (const slug of relatedNotes) {
  const note = noteBySlug.get(slug)
  if (note) {
    add({
      title: note.data.title,
      href: `/garden/${note.id}/`,
      type: 'garden',
      slug: note.id,
    })
  }
}

// related_posts: explicit garden→post
for (const postPath of relatedPosts) {
  const cleanSlug = postPath.replace(/^\/|\/$/g, '')
  const post = postByAbbrlink.get(cleanSlug)
  if (post) {
    add({
      title: post.data.title,
      href: `/${cleanSlug}/`,
      type: 'post',
    })
  }
}

// ── 2. Discovered backlinks (reverse connections) ──

const currentSlug = currentId
const gardenUrlPattern = `/garden/${currentSlug}/`
const gardenUrlPatternNoTrail = `/garden/${currentSlug}`

// Garden notes that reference this content
for (const note of allNotes) {
  if (note.id === currentId && collection === 'garden') continue

  // Check related_notes frontmatter (reverse: they list us)
  const noteRelated = note.data.related_notes || []
  if (noteRelated.includes(currentSlug)) {
    add({
      title: note.data.title,
      href: `/garden/${note.id}/`,
      type: 'garden',
      slug: note.id,
    })
    continue
  }

  // Check related_posts frontmatter (reverse: garden notes pointing at this post)
  if (collection === 'posts') {
    const noteRelatedPosts = note.data.related_posts || []
    if (noteRelatedPosts.some((rp: string) => {
      const clean = rp.replace(/^\/|\/$/g, '')
      return clean === currentSlug
    })) {
      add({
        title: note.data.title,
        href: `/garden/${note.id}/`,
        type: 'garden',
        slug: note.id,
      })
      continue
    }
  }

  // Check body for inline links
  if (note.body) {
    if (note.body.includes(gardenUrlPattern) || note.body.includes(gardenUrlPatternNoTrail)) {
      add({
        title: note.data.title,
        href: `/garden/${note.id}/`,
        type: 'garden',
        slug: note.id,
      })
    }
  }
}

// Posts that link to this garden note in their body
if (collection === 'garden') {
  for (const post of allPosts) {
    if (post.body) {
      if (post.body.includes(gardenUrlPattern) || post.body.includes(gardenUrlPatternNoTrail)) {
        const postSlug = post.data.abbrlink || post.id
        add({
          title: post.data.title,
          href: `/${postSlug}/`,
          type: 'post',
        })
      }
    }
  }
}

// Sort: garden notes first, then posts; alphabetically within each group
connections.sort((a, b) => {
  if (a.type !== b.type) return a.type === 'garden' ? -1 : 1
  return a.title.localeCompare(b.title)
})
---

{connections.length > 0 && (
  <div class="mt-10">
    <div class="uno-decorative-line" />
    <h2 class="mb-4 text-4 font-semibold">Connections</h2>
    <ul class="list-none p-0">
      {connections.map(link => (
        <li class="mb-2.5">
          <a
            href={link.href}
            class="transition-colors hover:c-primary"
          >
            {link.type === 'garden' && <span class="mr-1 text-3.25">{gardenEmoji(link.slug || '')}</span>}
            {link.type === 'post' && <span class="mr-1 text-3.25">🪶</span>}
            {link.title}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
